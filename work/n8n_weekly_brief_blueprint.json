{
  "name": "Weekly Industry Brief (Groq)",
  "nodes": [
    {
      "parameters": {},
      "id": "e7b8a9f0-1234-4567-890a-bcdef1234567",
      "name": "When clicking \"Test workflow\"",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [ 220, 200 ]
    },
    {
      "parameters": {
        "url": "https://feeds.feedburner.com/kdnuggets-data-mining-analytics"
      },
      "id": "3b7c8d9e-2345-5678-901b-cdef12345678",
      "name": "Fetch ML News",
      "type": "n8n-nodes-base.rssFeedRead",
      "typeVersion": 1,
      "position": [ 420, 200 ]
    },
    {
      "parameters": {
        "jsCode": "const items = $input.all();\nlet articlesText = \"\";\nconst limit = Math.min(items.length, 5);\nfor (let i = 0; i < limit; i++) {\n  const item = items[i].json;\n  articlesText += `Title: ${item.title}\\nLink: ${item.link}\\nSummary: ${item.contentSnippet || item.content}\\n\\n`;\n}\n\nconst groqPayload = {\n  model: \"llama3-70b-8192\",\n  messages: [\n    {\n      role: \"system\",\n      content: \"You are a senior ML researcher writing a Weekly Industry Brief. Read the following article summaries and synthesize them into a single, cohesive Markdown newsletter. Group related topics, use bullet points, and highlight the 'so what?' for ML practitioners. Do not just list them; weave them into a brief.\"\n    },\n    {\n      role: \"user\",\n      content: articlesText\n    }\n  ]\n};\n\nreturn [{ json: { articlesText, groqPayload } }];"
      },
      "id": "5c9d0e1f-3456-6789-012c-def123456789",
      "name": "Synthesize & Limit",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [ 620, 200 ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.groq.com/openai/v1/chat/completions",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "Bearer YOUR_GROQ_API_KEY_HERE"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ $json.groqPayload }}",
        "options": {}
      },
      "id": "7e1f2a3b-4567-7890-123d-ef1234567890",
      "name": "Groq LLM (Draft Brief)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [ 820, 200 ]
    },
    {
      "parameters": {
        "jsCode": "const response = $input.first().json;\nconst markdown = response.choices[0].message.content;\nreturn [{ json: { markdown_brief: markdown } }];"
      },
      "id": "9a3b4c5d-5678-8901-234e-f12345678901",
      "name": "Extract Markdown",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [ 1020, 200 ]
    }
  ],
